<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sits.viewer.ConnectController">
    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <Label text="Connect to Tournament Server" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
            
            <HBox spacing="10">
                <Label text="Server IP:" minWidth="80"/>
                <TextField fx:id="ipTextField" text="localhost" HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <HBox spacing="10">
                <Label text="Port:" minWidth="80"/>
                <TextField fx:id="portTextField" text="8080" prefWidth="100"/>
            </HBox>
            
            <Button text="Connect" onAction="#handleConnect" style="-fx-font-size: 12; -fx-padding: 8;"/>
        </VBox>
    </center>
</BorderPane>
