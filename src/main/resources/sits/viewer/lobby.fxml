<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sits.viewer.LobbyController">
    <top>
        <VBox style="-fx-padding: 10;">
            <Label text="Available Tournaments" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    
    <center>
        <ListView fx:id="tournamentList" VBox.vgrow="ALWAYS"/>
    </center>
    
    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Button fx:id="watchButton" text="Watch" onAction="#handleWatch" style="-fx-padding: 6;"/>
            <Button text="Refresh" onAction="#handleRefresh" style="-fx-padding: 6;"/>
        </HBox>
    </bottom>
</BorderPane>
